@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <title>Power fitness | Home</title>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-white my-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.jpg" alt="Logo" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Members" asp-action="Index">Members</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Trainers" asp-action="Index">Trainers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Sessions" asp-action="Index">Sessions</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Plans" asp-action="Index">Plans</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Memberships" asp-action="Index">Memberships</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Sessions" asp-action="Schedule">Sessions Schedule</a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit"
                                        class="btn btn-link nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative">
                                    Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <div class="row">
                <div class="col-md-6 col-lg-7 col-12">
                    <div class="info mt-4">
                        <header class="text-black-alternative">
                            <h2 class="fw-bolder display-2 mb-4">
                                Your body can
                                <span class="text-primary-color">stand almost</span> anything
                            </h2>

                            <p class="mb-6">
                                It's your mind that needs convincing. Push past your limits,
                                stay committed, and watch as your body transforms into a powerhouse of
                                strength and resilience. Start your journey today!
                            </p>
                        </header>

                        <div class="stats-bar">
                            <div class="row g-0">
                                <div class="col-4">
                                    <div class="stat">
                                        <span class="fw-bolder fs-5 d-block mb-1">100</span>
                                        <h3 class="fs-5 fw-normal">Total Members</h3>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat">
                                        <span class="fw-bolder fs-5 d-block mb-1">85</span>
                                        <h3 class="fs-5 fw-normal">Active Members</h3>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat">
                                        <span class="fw-bolder fs-5 d-block mb-1">20</span>
                                        <h3 class="fs-5 fw-normal">Trainers</h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="buttons my-4">
                            <a asp-controller="Account" asp-action="Register"
                               class="btn bg-primary-color text-white rounded-5 fw-medium px-3 py-2 me-5 border-2 border-primary-color">
                                Get Started
                            </a>

                            <a asp-controller="Home" asp-action="Explore"
                               class="btn border-primary-color rounded-5 fw-medium px-3 py-2 border-2 text-primary-color">
                                Explore More
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-1 offset-md-2 col-12 order-first order-md-last">
                    <div class="character d-md-block d-flex justify-content-center">
                        <img src="~/images/Theo Vance.jpg" alt="Theo Vance" />
                    </div>
                </div>
            </div>

            <div class="bar bg-primary-color d-flex py-4 text-white fw-bolder align-items-center">
                <p class="py-0 my-0 overflow-hidden text-nowrap">
                    outdoor & online trainers
                    <img src="~/images/star.svg" alt="star icon" /> personal training
                    <img src="~/images/star.svg" alt="star icon" /> live classes
                    <img src="~/images/star.svg" alt="star icon" /> personal trainers
                </p>
            </div>

           
        </main>
    </div>
</body>
</html>
