@using GymManagmentBSL.ViewModels.MemberViewModels
@model IEnumerable<MemberViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Members";
}

<header class="d-flex justify-content-end mt-5 mb-4 align-items-center">
    <a asp-controller="Member" asp-action="Create" class="btn btn-fill fw-medium rounded-pill px-3 py-3">
        + Add Member
    </a>
</header>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive" style="overflow: visible;">
        <table class="table table-borderless align-middle">
            <thead class="table-light">
                <tr>
                    <th>Photo</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Gender</th>
                    <th>Phone</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr>
                        <td>
                            <img src="~/images/User.jpg" alt="Avatar" class="rounded-circle"
                                 style="width: 40px; height: 40px;" />
                        </td>
                        <td>@member.Name</td>
                        <td>@member.Email</td>
                        <td>@member.Gender</td>
                        <td>@member.Phone</td>
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-link p-0 border-0" type="button"
                                        id="dropdownMenuButton-@member.Id" data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <img src="~/images/action dots.jpg" alt="action icon" />
                                </button>
                                <ul class="dropdown-menu dropdown-menu-start"
                                    aria-labelledby="dropdownMenuButton-@member.Id">
                                    <li>
                                        <a asp-controller="Member" asp-action="MemberDetails" asp-route-id="@member.Id"
                                           class="dropdown-item d-flex align-items-center gap-3">
                                            <i class="bi bi-info-circle"></i>
                                            <span>View Member Data</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-controller="Member" asp-action="HealthRecordDetails" asp-route-id="@member.Id"
                                           class="dropdown-item d-flex align-items-center gap-3">
                                            <i class="bi bi-heart-pulse"></i>
                                            <span>View Health Record</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a asp-controller="Member" asp-action="EditMember" asp-route-id="@member.Id"
                                           class="dropdown-item d-flex align-items-center gap-3">
                                            <i class="bi bi-pencil-square"></i>
                                            <span>Edit Member</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a asp-controller="Member" asp-action="Delete" asp-route-id="@member.Id"
                                           class="dropdown-item d-flex align-items-center gap-3 text-danger">
                                            <i class="bi bi-trash3"></i>
                                            <span>Delete</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-person-workspace display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No Members Available</h4>
        <p class="text-muted">Add your first Member to get started</p>
    </div>
}
