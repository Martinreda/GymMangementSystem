                <li class="nav-item">
                    <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                       asp-controller="Membership" asp-action="Index">Memberships</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5"
                       asp-controller="Schedule" asp-action="Index">Sessions Schedule</a>
                </li>
            </ul>
        </div>
