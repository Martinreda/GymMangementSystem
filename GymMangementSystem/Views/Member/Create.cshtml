@model CreateMemberViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Add Member";
}

<h3 class="text-primary-color mb-4">Add Member</h3>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div class="row g-3">

        <!-- Photo -->


        <!-- Name -->
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <!-- Email -->
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <!-- Phone -->
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <!-- Date of Birth -->
        <div class="col-md-6">
            <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
            <input asp-for="DateOfBirth" class="form-control" type="date" />
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>

        <!-- Gender -->
        <div class="col-md-6">
            <label asp-for="Gender" class="form-label">Gender</label>
            <select asp-for="Gender" class="form-select">
                <option value="">-- Select Gender --</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <!-- Address: Building Number -->
        <div class="col-md-6">
            <label asp-for="BuildingNumber" class="form-label">Building Number</label>
            <input asp-for="BuildingNumber" class="form-control" />
            <span asp-validation-for="BuildingNumber" class="text-danger"></span>
        </div>

        <!-- Street -->
        <div class="col-md-6">
            <label asp-for="Street" class="form-label">Street</label>
            <input asp-for="Street" class="form-control" />
            <span asp-validation-for="Street" class="text-danger"></span>
        </div>

        <!-- City -->
        <div class="col-md-6">
            <label asp-for="City" class="form-label">City</label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>

        <!-- Health Data -->

        <div class="col-md-6">
            <label asp-for="HealthRecord.Height" class="form-label">Height (cm)</label>
            <input asp-for="HealthRecord.Height" class="form-control" />
            <span asp-validation-for="HealthRecord.Height" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="HealthRecord.Weight" class="form-label">Weight (kg)</label>
            <input asp-for="HealthRecord.Weight" class="form-control" />
            <span asp-validation-for="HealthRecord.Weight" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="HealthRecord.BloodType" class="form-label">Blood Type</label>
            < asp-for="HealthRecord.BloodType" class="form-select" <select asp-for="HealthRecord.BloodType" class="form-select">
    <option value="">-- Select Blood Type --</option>
    <option value="A+">A+</option>
    <option value="A-">A-</option>
    <option value="B+">B+</option>
    <option value="B-">B-</option>
    <option value="O+">O+</option>
    <option value="O-">O-</option>
    <option value="AB+">AB+</option>
    <option value="AB-">AB-</option>
</select>
">
                <option value="">-- Select Blood Type --</option>
            </>
            <span asp-validation-for="HealthRecord.BloodType" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="HealthRecord.Note" class="form-label">Note</label>
            <textarea asp-for="HealthRecord.Note" class="form-control"></textarea>
            <span asp-validation-for="HealthRecord.Note" class="text-danger"></span>
        </div>

    </div>

    <button type="submit" class="btn btn-primary mt-4">Create Member</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
