@model GymManagmentBSL.ViewModels.PlanViewModels.PlanViewModel

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <!-- Dynamic Card Header Background Based on Status -->
                @{
                    var headerClass = Model.IsActive ? "bg-primary" : "bg-secondary";
                }
                <div class="card-header @headerClass text-white text-center py-5">
                    <i class="bi bi-award display-4 mb-3"></i>
                    <h2 class="mb-0">@Model.Name</h2>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4 py-3 bg-light rounded">
                        <div class="display-3 fw-bold text-primary-color">@Model.Price.ToString("N0")</div>
                        <small class="text-muted fs-5">EGP</small>
                    </div>

                    <div class="plan-details">
                        <div class="detail-item mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <div class="icon-box me-3">
                                    <i class="bi bi-calendar-check text-primary-color fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-muted">Duration</h6>
                                    <p class="mb-0 fw-bold">@Model.DurationDays days</p>
                                </div>
                            </div>
                        </div>

                        <div class="detail-item mb-4">
                            <div class="d-flex align-items-start mb-2">
                                <div class="icon-box me-3">
                                    <i class="bi bi-file-text text-primary-color fs-4"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-2 text-muted">Description</h6>
                                    <p class="mb-0">@Model.Description</p>
                                </div>
                            </div>
                        </div>

                        <div class="detail-item mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <div class="icon-box me-3">
                                    @if (Model.IsActive)
                                    {
                                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger fs-4"></i>
                                    }
                                </div>
                                <div>
                                    <h6 class="mb-0 text-muted">Status</h6>
                                    <p class="mb-0">
                                        @if (Model.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Plan Type -->
                        <div class="detail-item mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <div class="icon-box me-3">
                                    <i class="bi bi-tag text-primary-color fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-muted">Plan Type</h6>
                                    <p class="mb-0 fw-bold">@Model.Name</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-0 p-4">
                    <div class="d-flex justify-content-between gap-2">
                        <a asp-action="Index" class="btn btn-outline flex-fill">
                            <i class="bi bi-arrow-left me-1"></i>Back to List
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline flex-fill">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline text-danger flex-fill">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Hide alerts after 3 seconds
            const alertBox = document.getElementById("Alert");
            if (alertBox) {
                setTimeout(() => {
                    alertBox.style.transition = "opacity 0.5s ease";
                    alertBox.style.opacity = "0";
                    setTimeout(() => alertBox.remove(), 500);
                }, 3000);
            }

            // Add hover effects
            const card = document.querySelector('.card');
            if (card) {
                card.addEventListener('mouseenter', function () {
                    this.style.transform = 'translateY(-5px)';
                    this.style.transition = 'transform 0.3s ease';
                });

                card.addEventListener('mouseleave', function () {
                    this.style.transform = 'translateY(0)';
                });
            }
        });
    </script>
}

<style>
    .text-primary-color {
        color: #007bff !important;
    }

    .btn-outline {
        border: 1px solid #dee2e6;
        color: #495057;
        transition: all 0.3s ease;
    }

        .btn-outline:hover {
            background-color: #f8f9fa;
            border-color: #007bff;
            transform: translateY(-1px);
        }

    .card {
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
        }

    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(0, 123, 255, 0.1);
    }

    .detail-item {
        padding: 15px;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        .detail-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }

    .display-3 {
        font-size: 3.5rem;
        font-weight: 700;
    }

    .bg-primary {
        background: linear-gradient(135deg, #007bff, #0056b3) !important;
    }

    .bg-secondary {
        background: linear-gradient(135deg, #6c757d, #495057) !important;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.5rem 1rem;
        border-radius: 20px;
    }

    .display-4 {
        font-size: 4rem;
    }
</style>