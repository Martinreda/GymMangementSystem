@model GymManagmentBSL.ViewModels.TrianerViewModels.CreateTrainerViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add New Trainer - Power Fitness</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #4361ee;
            --secondary-color: #3f37c9;
            --light-bg: #f8f9fa;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .container {
            max-width: 900px;
        }

        .section-header {
            border-left: 4px solid var(--primary-color);
            padding-left: 1rem;
        }

        .form-control, .form-select {
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 12px 15px;
            transition: var(--transition);
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.2rem rgba(67, 97, 238, 0.25);
            }

        .btn-fill {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            border-radius: 8px;
            padding: 12px 30px;
            font-weight: 600;
            color: white;
            transition: var(--transition);
        }

            .btn-fill:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 14px rgba(67, 97, 238, 0.3);
                color: white;
            }

        .btn-outline-custom {
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
            border-radius: 8px;
            padding: 12px 30px;
            font-weight: 600;
            transition: var(--transition);
            background: white;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

            .btn-outline-custom:hover {
                background: var(--primary-color);
                color: white;
                transform: translateY(-2px);
            }

        .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

        .form-check-label {
            font-weight: 500;
            color: #495057;
        }

        .text-primary-color {
            color: var(--primary-color) !important;
        }

        .validation-message {
            font-size: 0.8rem;
            margin-top: 5px;
        }

        .card {
            border: none;
            border-radius: var(--border-radius);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            background: white;
        }

        .alert-custom {
            border: none;
            border-radius: var(--border-radius);
            padding: 1rem 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <!-- Alert Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-custom alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-custom alert-dismissible fade show">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card p-4">
            <header class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="text-primary-color mb-1">Add New Trainer</h3>
                    <p class="text-muted mb-0">Fill in the trainer's information below</p>
                </div>
                <a asp-controller="Trainer" asp-action="Index" class="btn-outline-custom">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </header>

            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()

                <!-- Personal Information -->
                <div class="section-header mb-3">
                    <h5 class="text-primary fw-bold">
                        <i class="fas fa-user me-2"></i>Personal Information
                    </h5>
                    <hr class="mt-2">
                </div>

                <div class="row g-3">
                    <!-- Name -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="Name" type="text" class="form-control" placeholder="Enter full name" />
                        <span asp-validation-for="Name" class="text-danger validation-message"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" />
                        <span asp-validation-for="Email" class="text-danger validation-message"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold">Phone Number</label>
                        <input asp-for="Phone" type="tel" class="form-control" placeholder="e.g., 01012345678" />
                        <span asp-validation-for="Phone" class="text-danger validation-message"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div class="col-12 col-md-6">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold">Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger validation-message"></span>
                    </div>

                    <!-- Gender -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Gender" class="form-label fw-semibold">Gender</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger validation-message"></span>
                    </div>
                </div>

                <!-- Address Information -->
                <div class="section-header mb-3 mt-4">
                    <h5 class="text-primary fw-bold">
                        <i class="fas fa-home me-2"></i>Address Information
                    </h5>
                    <hr class="mt-2">
                </div>

                <div class="row g-3">
                    <!-- Building Number -->
                    <div class="col-12 col-md-4">
                        <label asp-for="BuildingNumber" class="form-label fw-semibold">Building Number</label>
                        <input asp-for="BuildingNumber" type="number" class="form-control" placeholder="e.g., 123" min="1" />
                        <span asp-validation-for="BuildingNumber" class="text-danger validation-message"></span>
                    </div>

                    <!-- Street -->
                    <div class="col-12 col-md-4">
                        <label asp-for="Street" class="form-label fw-semibold">Street</label>
                        <input asp-for="Street" type="text" class="form-control" placeholder="Enter street name" />
                        <span asp-validation-for="Street" class="text-danger validation-message"></span>
                    </div>

                    <!-- City -->
                    <div class="col-12 col-md-4">
                        <label asp-for="City" class="form-label fw-semibold">City</label>
                        <input asp-for="City" type="text" class="form-control" placeholder="Enter city" />
                        <span asp-validation-for="City" class="text-danger validation-message"></span>
                    </div>
                </div>

                <!-- Professional Information -->
                <div class="section-header mb-3 mt-4">
                    <h5 class="text-primary fw-bold">
                        <i class="fas fa-dumbbell me-2"></i>Professional Information
                    </h5>
                    <hr class="mt-2">
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Specialties" class="form-label fw-semibold">
                            Specialization <span class="text-danger">*</span>
                        </label>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" asp-for="Specialties" value="GeneralFitness" />
                                    <label class="form-check-label">
                                        <i class="fas fa-running me-2 text-primary"></i>General Fitness
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" asp-for="Specialties" value="Yoga" />
                                    <label class="form-check-label">
                                        <i class="fas fa-spa me-2 text-success"></i>Yoga
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" asp-for="Specialties" value="Boxing" />
                                    <label class="form-check-label">
                                        <i class="fas fa-fist-raised me-2 text-danger"></i>Boxing
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" asp-for="Specialties" value="CrossFit" />
                                    <label class="form-check-label">
                                        <i class="fas fa-dumbbell me-2 text-warning"></i>CrossFit
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" asp-for="Specialties" value="Cardio" />
                                    <label class="form-check-label">
                                        <i class="fas fa-heartbeat me-2 text-info"></i>Cardio
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" asp-for="Specialties" value="StrengthTraining" />
                                    <label class="form-check-label">
                                        <i class="fas fa-weight-hanging me-2 text-secondary"></i>Strength Training
                                    </label>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="Specialties" class="text-danger validation-message"></span>
                    </div>
                </div>

                <!-- Form Actions -->
                <footer class="d-flex justify-content-between gap-3 mt-5 pt-4 border-top">
                    <a asp-controller="Trainer" asp-action="Index" class="btn-outline-custom">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-fill">
                        <i class="fas fa-plus me-2"></i>Add Trainer
                    </button>
                </footer>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Set max date for date of birth (18 years ago)
            const dobInput = document.querySelector('input[type="date"]');
            if (dobInput) {
                const today = new Date();
                const maxDate = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate());
                dobInput.max = maxDate.toISOString().split('T')[0];
            }

            // Add loading state to form submission
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function() {
                    const submitBtn = this.querySelector('button[type="submit"]');
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Adding Trainer...';
                });
            }

            // Auto-hide alerts after 5 seconds
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    alert.style.transition = "opacity 0.5s ease";
                    alert.style.opacity = "0";
                    setTimeout(() => {
                        if (alert.parentNode) {
                            alert.remove();
                        }
                    }, 500);
                }, 5000);
            });
        });
    </script>
</body>
</html>