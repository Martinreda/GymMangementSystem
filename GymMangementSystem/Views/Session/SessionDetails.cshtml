@model GymManagmentBSL.ViewModels.SessionViewModel.SessionViewModel

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <!-- Dynamic Card Header Background Based on Status -->
                @{
                    var headerClass = Model.Status switch
                    {
                        "Ongoing" => "bg-success",
                        "Upcoming" => "bg-primary",
                        "Completed" => "bg-secondary",
                        _ => "bg-primary"
                    };
                    var badgeClass = Model.Status switch
                    {
                        "Ongoing" => "bg-light text-success",
                        "Upcoming" => "bg-light text-primary",
                        "Completed" => "bg-light text-secondary",
                        _ => "bg-light text-dark"
                    };
                }
                <div class="card-header @headerClass text-white text-center py-4">
                    <i class="bi bi-calendar-event display-4 mb-3"></i>
                    <h2 class="mb-2">@Model.CategoryName</h2>
                    <span class="badge @badgeClass fs-6">@Model.Status</span>
                </div>

                <div class="card-body p-4">
                    <!-- Description -->
                    <div class="mb-4 p-3 bg-light rounded">
                        <h6 class="text-primary-color mb-2">
                            <i class="bi bi-file-text me-2"></i>Description
                        </h6>
                        <p class="mb-0">@Model.Description</p>
                    </div>

                    <!-- Session Details -->
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-person-circle text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Trainer</small>
                                        <strong>@Model.TrainerName</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-people text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Capacity</small>
                                        <strong>@Model.AvailableSlots / @Model.Capacity spots</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-calendar-check text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Date</small>
                                        <strong>@Model.DateDisplay</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-clock text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Time</small>
                                        <strong>@Model.TimeRangeDisplay</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-calendar-check text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Start Time</small>
                                        <strong>@Model.StartDate.ToString("MMM dd, yyyy hh:mm tt")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-calendar-x text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">End Time</small>
                                        <strong>@Model.EndDate.ToString("MMM dd, yyyy hh:mm tt")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="detail-box p-3 border rounded bg-light">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-hourglass-split text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">Duration</small>
                                        <strong class="text-primary-color fs-5">
                                            @{
                                                var duration = Model.Duration;
                                                var hours = (int)duration.TotalHours;
                                                var minutes = duration.Minutes;
                                            }
                                            @hours Hour@(hours != 1 ? "s" : "") @minutes Minute@(minutes != 1 ? "s" : "")
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-0 p-4">
                    <div class="d-flex justify-content-between gap-2">
                        <a asp-action="Index" class="btn btn-outline flex-fill">
                            <i class="bi bi-arrow-left me-1"></i>Back to List
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline flex-fill">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline text-danger flex-fill">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const alertBox = document.getElementById("Alert");
            if (alertBox) {
                setTimeout(() => {
                    alertBox.style.transition = "opacity 0.5s ease";
                    alertBox.style.opacity = "0";
                    setTimeout(() => alertBox.remove(), 500);
                }, 3000);
            }
        });
    </script>
}

<style>
    .text-primary-color {
        color: #007bff !important;
    }

    .btn-outline {
        border: 1px solid #dee2e6;
        color: #495057;
        transition: all 0.3s ease;
    }

        .btn-outline:hover {
            background-color: #f8f9fa;
            border-color: #007bff;
            transform: translateY(-1px);
        }

    .detail-box {
        transition: all 0.3s ease;
        height: 100%;
    }

        .detail-box:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(0, 123, 255, 0.1);
    }

    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        border-radius: 15px 15px 0 0 !important;
    }

    .badge {
        font-size: 0.8rem;
        padding: 0.5rem 1rem;
        border-radius: 20px;
    }
</style>