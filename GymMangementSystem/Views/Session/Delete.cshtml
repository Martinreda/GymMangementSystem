@model GymManagmentBSL.ViewModels.SessionViewModel.SessionViewModel

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 text-center">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-warning display-1"></i>
                    </div>

                    <h3 class="text-primary-color mb-3">Delete Session</h3>

                    <!-- Session Details -->
                    @if (Model != null)
                    {
                        <div class="session-details mb-4 p-3 border rounded bg-light text-start">
                            <h6 class="text-primary fw-bold mb-3">Session Information</h6>
                            <div class="row g-2">
                                <div class="col-12">
                                    <strong>Category:</strong> @Model.CategoryName
                                </div>
                                <div class="col-12">
                                    <strong>Trainer:</strong> @Model.TrainerName
                                </div>
                                <div class="col-12">
                                    <strong>Date:</strong> @Model.DateDisplay
                                </div>
                                <div class="col-12">
                                    <strong>Time:</strong> @Model.TimeRangeDisplay
                                </div>
                                <div class="col-12">
                                    <strong>Status:</strong>
                                    <span class="badge @(Model.Status == "Ongoing" ? "bg-success" : Model.Status == "Upcoming" ? "bg-primary" : "bg-secondary")">
                                        @Model.Status
                                    </span>
                                </div>
                                <div class="col-12">
                                    <strong>Capacity:</strong> @Model.AvailableSlots/@Model.Capacity slots available
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Warning Messages -->
                    @if (!ViewBag.CanDelete)
                    {
                        <div class="alert alert-danger text-start mb-4">
                            <strong><i class="bi bi-x-circle-fill me-2"></i>Cannot Delete:</strong>
                            <p class="mb-0 mt-1">@ViewBag.DeleteReason</p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-start mb-4">
                            <strong><i class="bi bi-info-circle me-2"></i>Warning:</strong>
                            This action cannot be undone. All session data and bookings will be permanently deleted.
                        </div>
                    }

                    <p class="text-muted mb-4">Are you sure you want to delete this session?</p>

                    @if (ViewBag.CanDelete)
                    {
                        <form asp-action="DeleteConfirmed" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="d-flex justify-content-between gap-3">
                                <a asp-action="Index" class="btn btn-outline flex-fill">
                                    <i class="bi bi-x-lg me-1"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-danger flex-fill">
                                    <i class="bi bi-trash me-1"></i>Delete Session
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-primary flex-fill">
                                <i class="bi bi-arrow-left me-1"></i>Back to List
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Hide alerts after 3 seconds
            const alertBox = document.getElementById("Alert");
            if (alertBox) {
                setTimeout(() => {
                    alertBox.style.transition = "opacity 0.5s ease";
                    alertBox.style.opacity = "0";
                    setTimeout(() => alertBox.remove(), 500);
                }, 3000);
            }

            // Confirm delete with additional warning
            const deleteForm = document.querySelector('form[asp-action="DeleteConfirmed"]');
            if (deleteForm) {
                deleteForm.addEventListener('submit', function (e) {
                    const sessionName = '@Model?.CategoryName';
                    const sessionDate = '@Model?.DateDisplay';

                    if (!confirm(`Are you absolutely sure you want to delete the session "${sessionName}" on ${sessionDate}? This action is permanent and cannot be undone.`)) {
                        e.preventDefault();
                    }
                });
            }

            // Add visual feedback for delete button
            const deleteButton = document.querySelector('.btn-danger');
            if (deleteButton) {
                deleteButton.addEventListener('mouseover', function () {
                    this.style.transform = 'scale(1.02)';
                });

                deleteButton.addEventListener('mouseout', function () {
                    this.style.transform = 'scale(1)';
                });
            }
        });
    </script>
}

<style>
    .text-primary-color {
        color: #007bff !important;
    }

    .btn-outline {
        border: 1px solid #dee2e6;
        color: #495057;
        transition: all 0.3s ease;
    }

        .btn-outline:hover {
            background-color: #f8f9fa;
            border-color: #007bff;
            transform: translateY(-1px);
        }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
            transform: translateY(-1px);
        }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
            transform: translateY(-1px);
        }

    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .session-details {
        border-left: 4px solid #007bff;
    }

    .alert-warning {
        background-color: #fff3cd;
        border-color: #ffeaa7;
        color: #856404;
    }

    .alert-danger {
        background-color: #f8d7da;
        border-color: #f5c6cb;
        color: #721c24;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.35em 0.65em;
    }

    .display-1 {
        font-size: 4rem;
    }
</style>